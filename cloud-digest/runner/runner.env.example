# 文章庫 Worker 網址（HTTPS）。
TECHNEWS_URL=https://your-worker.example.workers.dev
# 與 Worker secret LEARNING_RUNNER_TOKEN 相同；不要使用網站登入的 RUN_TOKEN。
TECHNEWS_RUNNER_TOKEN=
# 顯示在管理頁的執行器名稱，只能用英數、點、底線與連字號。
RUNNER_ID=mac-runner

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:26b
# 固定 context，避免每份工作改變大小而重新載入模型；數值依實測調整。
OLLAMA_NUM_CTX=65536
OLLAMA_NUM_PREDICT=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.3

RUNNER_POLL_SECONDS=20
RUNNER_HEARTBEAT_SECONDS=30
# RUNNER_DEBUG_DIR=

# X 長文代抓：專用 Chrome profile 資料夾（放在 repo 外）。設定並執行 --x-login 登入後才會領取代抓工作。
# RUNNER_X_PROFILE_DIR=/Users/<你>/.config/technews-runner/x-profile
