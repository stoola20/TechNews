{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "developer-digest-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    // 01:00 UTC = 09:00 Asia/Taipei.
    "crons": ["0 1 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "developer-digest-cloud",
      "database_id": "58114115-4d4d-47e6-8092-730fe58b4eb0"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
