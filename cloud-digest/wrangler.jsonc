{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "developer-digest-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    // 00:00 UTC = 08:00 Asia/Taipei 開始官方整理；任務對應見 src/schedule.js。
    "crons": ["0 0 * * *", "*/10 * * * *", "*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "developer-digest-cloud",
      "database_id": "58114115-4d4d-47e6-8092-730fe58b4eb0"
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  // 保留文章的 RAG 索引：512 維、cosine。建立指令見 docs/learning-setup.md。
  "vectorize": [{ "binding": "LIBRARY_INDEX", "index_name": "technews-library", "remote": true }],
  "browser": { "binding": "BROWSER", "remote": true },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "technews-learning-media" }],
  "queues": {
    "producers": [{ "binding": "LEARNING_JOBS", "queue": "technews-learning-jobs" }],
    "consumers": [{ "queue": "technews-learning-jobs", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "max_concurrency": 1 }]
  },
  "vars": {
    "MAX_ARTICLE_CHARS": "150000",
    "MAX_ARTICLE_AGE_DAYS": "7",
    "LEARNING_MODEL": "gemini-3.8-flash",
    "LEARNING_MONTHLY_USD": "30",
    "LEARNING_BASE_USD": "0",
    "X_API_FIELDS_STYLE": "post",
    // 網路查證的 Gemini Google 搜尋：每月免費次數與超過後每 1,000 次的美元價格。同一把金鑰也用在其他地方時，免費次數設為 0。
    "LEARNING_SEARCH_FREE_PER_MONTH": "5000",
    "LEARNING_SEARCH_USD_PER_1K": "14"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
